# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=robot_db
DB_USER=postgres
DB_PASSWORD=postgres

# SERVER
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins allowed to call backend APIs from browser.
# Leave empty to allow all origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-domain.com,http://your-domain.com

# MQTT
MQTT_BROKER=mqtt://localhost:1883
MQTT_TOPIC=robot/commands

# CAMERA PROXY
CAMERA_SOURCE_URL=http://127.0.0.1:8080
CAMERA_REQUIRE_AUTH=false

# GPS
GPS_ROBOT_ID=kali-vega-01

# AUTH
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ADMIN SEED
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@robot.local
ADMIN_PASSWORD=Admin@123

# FRONTEND OVERRIDES (optional)
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_WS_DASHBOARD=ws://localhost:5000/ws/dashboard
# REACT_APP_LOCAL_API_PORT=5000
# REACT_APP_DOMAIN_API_PORT=5000
