# Optional explicit URLs (highest priority)
# REACT_APP_API_URL=http://localhost:5000
# REACT_APP_WS_DASHBOARD=ws://localhost:5000/ws/dashboard

# Auto-switch mode when explicit URLs are not set:
# - localhost/127.0.0.1 will use REACT_APP_LOCAL_API_PORT
# - domain hostname will use REACT_APP_DOMAIN_API_PORT
REACT_APP_LOCAL_API_PORT=5000
REACT_APP_DOMAIN_API_PORT=5000
